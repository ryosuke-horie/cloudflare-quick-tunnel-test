# === Build Stage ===
FROM node:22-alpine AS builder

# 作業ディレクトリを /app に設定
WORKDIR /app

# Next.js アプリの依存情報を先にコピーしてインストール
COPY web/package*.json ./
RUN npm install

# ソースコード全体をコピーしてビルド
COPY web ./
RUN npm run build

# === Production Stage ===
FROM node:22-alpine

WORKDIR /app

# builder ステージでビルドした成果物をコピー
COPY --from=builder /app ./

# Next.js 用環境変数の設定
ENV NODE_ENV=production
ENV PORT=3000

EXPOSE 3000

# package.json の start スクリプトが "next start" などになっている前提
CMD ["npm", "start"]
